# ─── METARDU Environment Variables ───
# Copy this file to .env (for Docker Compose) or .env.local (for dev server)
# and fill in the values. Required variables are marked with [REQUIRED].
#
# AUDIT FIX (H8, 2026-07-02): All secrets now use placeholder values.
# Generate strong random secrets with:
#   openssl rand -base64 32
# Never commit real secrets to version control.

# ─── Docker Compose secrets (read by docker-compose.yml) ───
# PostgreSQL bootstrap credentials (used only by PostgreSQL, migrations, and backups)
POSTGRES_DB=metardu
POSTGRES_USER=metardu
POSTGRES_PASSWORD=          # [REQUIRED] generate: openssl rand -base64 24

# Restricted web-app database login. Use a separate randomly generated password.
APP_DB_USER=metardu_app
APP_DB_PASSWORD=             # [REQUIRED for Docker Compose] generate: openssl rand -base64 32

# Optional isolated staging stack (.env.staging)
STAGING_POSTGRES_DB=metardu_staging
STAGING_POSTGRES_USER=metardu_staging
STAGING_POSTGRES_PASSWORD=
STAGING_APP_DB_USER=metardu_staging_app
STAGING_APP_DB_PASSWORD=
STAGING_AUTH_SECRET=

# Auth secret (used by NextAuth for JWT signing) [REQUIRED]
# Generate with: openssl rand -base64 32
AUTH_SECRET=

# Worker secret (shared between Next.js app and Python compute worker)
WORKER_SECRET=              # [REQUIRED] generate: openssl rand -base64 32

# ─── Core ───
# Local development connection string. Docker Compose uses the restricted APP_DB_* login.
DATABASE_URL=postgresql://metardu:CHANGE_ME@localhost:5432/metardu

NEXTAUTH_URL=http://localhost:3000

# Admin emails (comma-separated) — these users get admin role
ADMIN_EMAILS=

# ─── App URLs ───
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional ChatGPT MCP connector. Keep disabled until privacy notice, migrations, and production verification are complete.
METARDU_MCP_ENABLED=false
METARDU_MCP_ORIGIN=https://metardu.space

# ─── Database (optional overrides) ───
DB_HOST=localhost
DB_PORT=5432
DB_NAME=metardu_dev
DB_USER=postgres
DB_PASSWORD=

# ─── Connection Pool Tuning (optional) ───
# Pool size — set based on (PostgreSQL max_connections - reserved - other apps).
# Rule of thumb: peak_qps × avg_query_ms / 1000. Default 20.
DB_POOL_MAX=20
# Idle connection timeout (ms) — connections idle longer than this are closed.
DB_POOL_IDLE_TIMEOUT_MS=30000
# Connection acquisition timeout (ms) — fail fast when DB is unavailable.
DB_POOL_CONNECT_TIMEOUT_MS=2000
# Per-statement timeout (ms) — prevents runaway queries from holding locks.
DB_STATEMENT_TIMEOUT_MS=10000


# ─── Payments: Stripe ───
# Setup: https://dashboard.stripe.com/apikeys
# 1. Copy the Secret key here
# 2. Create a webhook endpoint: https://your-domain.com/api/webhooks/stripe
# 3. Copy the webhook signing secret here
# 4. Copy the Publishable key for the client
STRIPE_SECRET_KEY=                    # [REQUIRED for card payments] sk_live_... or sk_test_...
STRIPE_WEBHOOK_SECRET=                # [REQUIRED for webhook verification] whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=   # [REQUIRED for client] pk_live_... or pk_test_...

# ─── Payments: PayPal ───
# Setup: https://developer.paypal.com/dashboard/applications/live
# 1. Create a REST API app → copy Client ID + Secret
# 2. Add a webhook: https://your-domain.com/api/webhooks/paypal
# 3. Subscribe to: CHECKOUT.ORDER.APPROVED, CHECKOUT.ORDER.COMPLETED, PAYMENT.CAPTURE.REFUNDED
# 4. Copy the Webhook ID here
# 5. Set PAYPAL_MODE to 'live' for production, 'sandbox' for testing
PAYPAL_CLIENT_ID=                     # [REQUIRED for PayPal] 
PAYPAL_CLIENT_SECRET=                 # [REQUIRED for PayPal]
PAYPAL_MODE=sandbox                   # 'sandbox' or 'live'
PAYPAL_WEBHOOK_ID=                    # [REQUIRED in production] from PayPal dashboard
# Currency-specific recurring plans; local currencies without a PayPal plan use USD pricing.
# Every ID must be an active monthly PayPal plan matching that catalog currency and amount.
PAYPAL_PLAN_PRO_USD=
PAYPAL_PLAN_PRO_EUR=
PAYPAL_PLAN_PRO_GBP=
PAYPAL_PLAN_PRO_AUD=
PAYPAL_PLAN_TEAM_USD=
PAYPAL_PLAN_TEAM_EUR=
PAYPAL_PLAN_TEAM_GBP=
PAYPAL_PLAN_TEAM_AUD=
PAYPAL_PLAN_FIRM_USD=
PAYPAL_PLAN_FIRM_EUR=
PAYPAL_PLAN_FIRM_GBP=
PAYPAL_PLAN_FIRM_AUD=
# Legacy USD-only fallbacks for older deployments; prefer the currency-specific IDs above.
PAYPAL_PLAN_PRO=
PAYPAL_PLAN_TEAM=
PAYPAL_PLAN_FIRM=
PAYPAL_PLAN_ENTERPRISE=               # Legacy only; Enterprise is contact-sales, not self-serve checkout
NEXT_PUBLIC_PAYPAL_CLIENT_ID=         # [REQUIRED for client] same as PAYPAL_CLIENT_ID

# ─── Payments: M-Pesa (Safaricom Daraja API) ───
# Setup: https://developer.safaricom.co.ke/
# 1. Create an app → copy Consumer Key + Consumer Secret
# 2. Get your Short Code (Paybill or Till number) from Safaricom
# 3. Get the Passkey from the Daraja portal (Lipa Na M-Pesa Online → Go Live)
# 4. Set MPESA_ENV to 'production' when going live (requires Daraja go-live approval)
# 5. Register the callback URL: https://your-domain.com/api/payments/mpesa/callback
# 6. (Optional) Set MPESA_CALLBACK_IP_WHITELIST if Safaricom adds new IPs
MPESA_CONSUMER_KEY=                   # [REQUIRED for M-Pesa]
MPESA_CONSUMER_SECRET=                # [REQUIRED for M-Pesa]
MPESA_SHORT_CODE=                     # [REQUIRED] Your Paybill/Till number
MPESA_SHORTCODE=                      # (alias for MPESA_SHORT_CODE)
NEXT_PUBLIC_MPESA_TILL_NUMBER=3370347 # M-Pesa Buy Goods Till Number (shown on checkout & verified)
MPESA_TILL_NUMBER=3370347
MPESA_INITIATOR_NAME=                 # [For B2B/C2B only] 
MPESA_SECURITY_CREDENTIAL=            # [For B2B only]
MPESA_PASSKEY=                        # [REQUIRED for STK Push] Lipa Na M-Pesa Online passkey
MPESA_ENV=sandbox                     # 'sandbox' or 'production'
MPESA_CALLBACK_IP_WHITELIST=          # (Optional) Comma-separated Safaricom IPs. Defaults to known list.

# ─── Payments: Airtel Money ───
AIRTEL_CLIENT_ID=
AIRTEL_CLIENT_SECRET=

# ─── Email: SMTP ───
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_PASSWORD=                     # Alternative name accepted by deployments
EMAIL_FROM="METARDU <noreply@metardu.space>"
EMAIL_REPLY_TO=
SUPPORT_EMAIL=

# ─── Email: Resend (alternative to SMTP) ───
RESEND_API_KEY=
RESEND_FROM_EMAIL="METARDU <noreply@metardu.space>"

# ─── Monitoring: Sentry ───
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=production
SENTRY_ORG=
SENTRY_PROJECT=

# ─── Monitoring: Logging ───
NEXT_PUBLIC_LOG_ENDPOINT=

# ─── Rate Limiting: Upstash Redis ───
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ─── Caching: Redis ───
REDIS_URL=redis://localhost:6379

# ─── Storage: Google Cloud Storage ───
STORAGE_ROOT=./uploads
GCS_PROJECT_ID=
GCS_BUCKET_NAME=
GCS_KEY_FILE=

# ─── AI / Compute ───
NVIDIA_API_KEY=
NEXT_PUBLIC_AI_SERVICE_URL=https://metardu-ai.up.railway.app
# FastAPI compute worker (docker-compose service `metardu-worker`).
# Set only when the worker runs (docker-compose sets it automatically):
#   http://metardu-worker:8000 inside the compose network, or
#   http://localhost:8000 for a locally started worker.
# Enables: GNSS RINEX processing (SPP) — /tools/gnss-rinex and /api/gnss/*.
# Must match WORKER_SECRET on the worker container.
PYTHON_COMPUTE_URL=
WORKER_SECRET=
PYTHON_SERVICE_URL=
API_ADMIN_KEY=

# ─── Photogrammetry: WebODM (Open Drone Map) ───
# Optional — enables drone photo processing (orthophoto + point cloud + DSM/DTM + contours).
# If not set, the drone upload page still works but processing must be done externally.
# Setup: docker run -p 3000:3000 opendronemap/webodm
# Then: WebODM → Profile → API Tokens → copy token
WEBODM_URL=
WEBODM_TOKEN=

# ─── Integrations: Ardhisasa (disabled until an official API contract is supplied) ───
# Public portal materials do not publish a developer API contract. Do not enable these
# flags or enter credentials until the Ministry supplies a contract and METARDU verifies it.
ARDHISASA_API_ENABLED=false
ARDHISASA_API_CONTRACT_VERIFIED=false
ARDHISASA_API_KEY=
ARDHISASA_CLIENT_ID=
ARDHISASA_CLIENT_SECRET=
ARDHISASA_BASE_URL=
ARDHISASA_ENVIRONMENT=

# ─── Integrations: KENCORS ───
KENCORS_API_KEY=

# ─── NTRIP WebSocket Proxy (P0-6) ───
# The ntrip-proxy.js bridge runs as its own Docker service
# (metardu-ntrip) and lets browsers reach NTRIP casters (RTCM RTK
# correction streams) over WebSocket. Browsers can't open raw TCP.
#
# NTRIP_PORT — host port to expose the proxy on (default 8090)
# NTRIP_ALLOWED_HOSTS — comma-separated caster hostnames the proxy
#   will connect to. If empty, ALL hosts are allowed (dev only —
#   always set this in production to prevent the proxy being used as
#   an open relay). Example: rtk.kenyacors.go.ke,caster.centipede.fr
NTRIP_PORT=8090
NTRIP_ALLOWED_HOSTS=

# ─── WhatsApp ───
NEXT_PUBLIC_WHATSAPP_NUMBER=

# ─── Google ───
GOOGLE_SITE_VERIFICATION=

# ─── Auth: Google OAuth ───
# Create credentials at https://console.cloud.google.com/apis/credentials
# Add http://localhost:3000/api/auth/callback/google as an authorized redirect URI
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── Auth: Microsoft / Azure AD OAuth ───
# Create an app registration at https://portal.azure.com/#blade/Microsoft_AAD_RegisteredApps
# Add http://localhost:3000/api/auth/callback/azure-ad as a redirect URI
AZURE_AD_CLIENT_ID=
AZURE_AD_CLIENT_SECRET=

# ─── PWA / Mobile ───
DISABLE_PWA=false
ENABLE_PWA_ON_WINDOWS=false
MOBILE_BUILD=false

# ─── Misc ───
ANALYZE=false
NEXT_PUBLIC_WHATSAPP_NUMBER=

# ─── Ops scripts (audit C-01, 2026-08-30) ───
# VM connection for scripts/vm-*.js and deploy helpers — never hardcoded.
VM_HOST=
VM_USER=opc
VM_PASSWORD=           # optional SSH password fallback; key auth preferred
PGPASSWORD=            # only for scripts/deploy-step2.js psql steps

# ─── Admin seeding (audit C-01, 2026-08-30) ───
# Required by scripts/seed-admin.ts — no credentials are stored in git.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=   # min 8 chars
SEED_ADMIN_NAME=Administrator

# ─── Payments hardening (audit H-03, 2026-08-30) ───
# REQUIRED for the PayPal webhook to accept any event (fail closed without it).
PAYPAL_WEBHOOK_ID=

# ─── Realtime collaboration (audit H-09, 2026-08-30) ───
# Room tickets are signed with AUTH_SECRET; clients request them at
# POST /api/realtime/ticket (requires project membership).
# Self-hosted y-webrtc signaling (optional; the public yjs.dev default is disabled):
NEXT_PUBLIC_COLLAB_SIGNALING_URL=

# ─── NTRIP proxy (audit H-11, 2026-08-30) ───
# Default-deny: the proxy refuses every caster until NTRIP_ALLOWED_HOSTS is set.
NTRIP_ALLOWED_HOSTS=
NTRIP_PROXY_SECRET=    # optional shared secret for the WS endpoint
