# Dockerfile.collaboration — WebSocket collaboration server
#
# Lightweight dedicated image for the realtime collaboration server.
# Only needs `ws` and the shared Zod protocol at runtime — NOT the full app dependency tree (canvas,
# postgres, etc.), so we install only those dependencies and compile the entry
# file without installing the full application dependency tree.

# ── Builder: compile the TS module ─────────────────────────────────────────
FROM node:20-alpine AS builder

WORKDIR /app

# Install the transport and pinned protocol validator. Avoid pulling
# in canvas/better-sqlite3/puppeteer which would need native build toolchain.
RUN npm init -y && npm install ws@^8.21.0 zod@4.6.7 --no-audit --no-fund

# Pull the typescript compiler + node types from npm without installing full deps.
# NOTE: @types/node is pinned to ~20.19.x to MATCH the workspace's own
# @types/node — the older ~20.10.x defs type timingSafeEqual() as
# ArrayBufferView (ArrayBuffer-backed under TS 5.9 generics), which rejects
# Node Buffer arguments and broke the standalone collaboration build
# (found during the 2026-08-30 security-remediation deploy).
RUN npm install typescript@~5.9.0 @types/node@~20.19.0 @types/ws@^8.5.10 --no-audit --no-fund

COPY src/lib/realtime/ ./src/lib/realtime/
COPY tsconfig.json ./

# Compile the entry file (which imports collaborationServer.ts) to CommonJS.
RUN npx tsc --module commonjs --moduleResolution node --target es2020 \
    --esModuleInterop --skipLibCheck --resolveJsonModule \
    --outDir dist src/lib/realtime/collabEntry.ts

# ── Runner: minimal runtime ────────────────────────────────────────────────
FROM node:20-alpine

WORKDIR /app

# Match the transport and shared protocol dependencies in the builder.
RUN npm init -y && npm install ws@^8.21.0 zod@4.6.7 --no-audit --no-fund

# Copy compiled JS (tsc flattens to outDir root since all inputs share src/lib/realtime)
COPY --from=builder /app/dist/collabEntry.js ./collabEntry.js
COPY --from=builder /app/dist/collaborationServer.js ./collaborationServer.js
COPY --from=builder /app/dist/collaborationProtocol.js ./collaborationProtocol.js
COPY --from=builder /app/dist/roomTicket.js ./roomTicket.js

# Non-root user
RUN addgroup --system --gid 1001 collab && \
    adduser --system --uid 1001 --ingroup collab collab
USER collab

EXPOSE 3001

HEALTHCHECK --interval=10s --timeout=5s --retries=3 --start-period=5s \
  CMD wget -qO- http://127.0.0.1:3001/health || exit 1

CMD ["node", "collabEntry.js"]
