{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "incremental": true,
    "types": ["node", "react", "react-dom", "jest"]
  },
  "include": [
    "next-env.d.ts",
    "src/**/*.d.ts",
    "src/test-utils/**/*.ts",
    "src/test-utils/**/*.tsx",
    "tests/**/*.ts",
    "tests/**/*.tsx",
    "src/**/*.test.ts",
    "src/**/*.test.tsx",
    "src/**/__tests__/**/*.ts",
    "src/**/__tests__/**/*.tsx"
  ],
  "exclude": [
    "node_modules",
    "android",
    "scripts",
    "server",
    "%TEMP%",
    "**/%TEMP%/**",
    "**/OpenAgentsControl/**"
  ]
}
