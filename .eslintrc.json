{
  "extends": [
    "next/core-web-vitals",
    "next/typescript"
  ],
  "plugins": [
    "metardu"
  ],
  "parserOptions": {
    "project": [
      "./tsconfig.json",
      "./tsconfig.tests.json"
    ]
  },
  "ignorePatterns": [
    "!src/app/.well-known/",
    "!src/app/.well-known/**"
  ],
  "rules": {
    "react/no-unescaped-entities": "off",
    "@next/next/no-page-custom-font": "off",
    "@typescript-eslint/no-explicit-any": "error",
    "@typescript-eslint/no-unsafe-assignment": "error",
    "@typescript-eslint/no-unsafe-member-access": "error",
    "@typescript-eslint/no-unsafe-call": "error",
    "@typescript-eslint/no-unsafe-argument": "error",
    "@typescript-eslint/no-unsafe-return": "error",
    "@typescript-eslint/no-unused-vars": [
      "error",
      {
        "argsIgnorePattern": "^_",
        "varsIgnorePattern": "^_"
      }
    ],
    "@typescript-eslint/no-non-null-assertion": "error",
    "@typescript-eslint/ban-ts-comment": "warn",
    "@typescript-eslint/prefer-as-const": "warn",
    "@typescript-eslint/no-require-imports": "warn",
    "react-hooks/exhaustive-deps": "error",
    "react-hooks/purity": "off",
    "react/display-name": "off",
    "react/prop-types": "off",
    "react-compiler/react-compiler": "off",
    "@next/next/no-img-element": "off",
    "@next/next/no-html-link-for-pages": "off",
    "prefer-const": "warn",
    "no-unused-vars": "off",
    "no-console": "warn",
    "no-debugger": "warn",
    "no-empty": [
      "warn",
      {
        "allowEmptyCatch": true
      }
    ],
    "no-irregular-whitespace": "warn",
    "no-case-declarations": "off",
    "no-fallthrough": "warn",
    "no-mixed-spaces-and-tabs": "warn",
    "no-redeclare": "warn",
    "no-undef": "off",
    "no-unreachable": "warn",
    "no-useless-escape": "warn",
    "metardu/no-placeholder-as-aria-label": "error",
    "metardu/no-hardcoded-srid-default": "warn",
    "metardu/no-web-mercator-measure": "warn",
    "no-restricted-syntax": [
      "error",
      {
        "selector": "TSInterfaceDeclaration[id.name='SurveyPoint']",
        "message": "Do not declare a local 'SurveyPoint' interface. Import it from '@/types/surveyPoint' instead. If you need a different shape, use Point2D / Point3D / SurveyPointWithCode / SurveyPoint3D, or name your interface differently (e.g. 'SurveyPointRow')."
      },
      {
        "selector": "CallExpression Literal[value=/^EPSG:21\\d{3}$/]",
        "message": "T1.5 (2026-07-09): Hardcoded EPSG:21xxx in a function call — use currentUtmEpsg from MapReactContext instead. Hardcoded CRS literals cause silent wrong-coordinate bugs outside UTM Zone 37S (Mombasa, Kisumu, Turkana). See MapClient.tsx currentUtmEpsg for the pattern."
      },
      {
        "selector": "CallExpression Literal[value=/^EPSG:32[67]\\d{2}$/]",
        "message": "T1.5 (2026-07-09): Hardcoded WGS84 UTM (EPSG:326xx/327xx) in a function call — use currentUtmEpsg from MapReactContext instead."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "scripts/**/*.ts",
        "e2e/**/*.ts",
        "capacitor.config.ts",
        "playwright.config.ts"
      ],
      "parserOptions": {
        "project": [
          "./tsconfig.lint-owned.json"
        ]
      }
    },
    {
      "files": [
        "src/test-utils/**/*.ts",
        "src/test-utils/**/*.tsx",
        "tests/**/*.ts",
        "tests/**/*.tsx",
        "src/**/*.test.ts",
        "src/**/*.test.tsx",
        "src/**/__tests__/**/*.ts",
        "src/**/__tests__/**/*.tsx"
      ],
      "parserOptions": {
        "project": [
          "./tsconfig.tests.json"
        ]
      }
    },
    {
      "files": [
        "scripts/engine-verify.ts",
        "scripts/verify-export-repair.ts"
      ],
      "parserOptions": {
        "project": [
          "./tsconfig.lint-tools.json"
        ]
      }
    },
    {
      "files": [
        "src/types/surveyPoint.ts"
      ],
      "rules": {
        "no-restricted-syntax": [
          "error",
          {
            "selector": "CallExpression Literal[value=/^EPSG:21\\d{3}$/]",
            "message": "T1.5 (2026-07-09): Hardcoded EPSG:21xxx in a function call — use currentUtmEpsg from MapReactContext instead. Hardcoded CRS literals cause silent wrong-coordinate bugs outside UTM Zone 37S (Mombasa, Kisumu, Turkana). See MapClient.tsx currentUtmEpsg for the pattern."
          },
          {
            "selector": "CallExpression Literal[value=/^EPSG:32[67]\\d{2}$/]",
            "message": "T1.5 (2026-07-09): Hardcoded WGS84 UTM (EPSG:326xx/327xx) in a function call — use currentUtmEpsg from MapReactContext instead."
          }
        ]
      }
    },
    {
      "files": [
        "src/lib/map/**/*.ts",
        "src/lib/survey/**/*.ts",
        "src/lib/geodesy/**/*.ts",
        "src/lib/geo/**/*.ts",
        "src/app/map/**/*.tsx",
        "src/app/map/**/*.ts"
      ],
      "rules": {
        "@typescript-eslint/no-explicit-any": "error",
        "@typescript-eslint/no-unsafe-assignment": "error",
        "@typescript-eslint/no-unsafe-member-access": "error",
        "@typescript-eslint/no-unsafe-call": "error",
        "@typescript-eslint/no-unsafe-argument": "error",
        "@typescript-eslint/no-unsafe-return": "error"
      }
    },
    {
      "files": [
        "src/lib/map/__tests__/nativeProjectionView.test.ts",
        "src/lib/surveyMapEngine/__tests__/pointLoading.test.ts",
        "src/app/api/project/*/points/__tests__/route.test.ts"
      ],
      "rules": {
        "no-restricted-syntax": "off"
      }
    },
    {
      "files": [
        "src/lib/spatial/**/*.ts"
      ],
      "rules": {
        "no-restricted-syntax": [
          "error",
          {
            "selector": "TSInterfaceDeclaration[id.name='SurveyPoint']",
            "message": "Do not declare a local 'SurveyPoint' interface. Import it from '@/types/surveyPoint' instead. If you need a different shape, use Point2D / Point3D / SurveyPointWithCode / SurveyPoint3D, or name your interface differently (e.g. 'SurveyPointRow')."
          }
        ]
      }
    },
    {
      "files": [
        "src/lib/surveyMapEngine/**/*.ts",
        "src/lib/surveyMapEngine/**/*.tsx"
      ],
      "rules": {
        "metardu/no-hardcoded-srid-default": "error",
        "metardu/no-web-mercator-measure": "error"
      }
    },
    {
      "files": [
        "scripts/**/*.js",
        "scripts/**/*.mjs",
        "scripts/**/*.cjs",
        "tests/**/*.js",
        "tests/**/*.mjs",
        "eslint-plugin-metardu/**/*.js",
        "eslint-plugin-metardu/**/*.cjs",
        "data/**/*.cjs",
        "jest.chatgpt.config.cjs",
        "jest.config.js",
        "next.config.js",
        "ntrip-proxy.js",
        "postcss.config.js",
        "tailwind.config.js"
      ],
      "extends": [
        "plugin:@typescript-eslint/disable-type-checked"
      ],
      "parserOptions": {
        "project": null
      }
    },
    {
      "files": [
        "scripts/**/*.{js,mjs,cjs,ts,mts,cts}",
        "tests/**/*.{js,mjs,cjs}",
        "ntrip-proxy.js"
      ],
      "rules": {
        "no-console": "off"
      }
    },
    {
      "files": [
        "**/*.cjs",
        "eslint-plugin-metardu/**/*.js",
        "scripts/**/*.js",
        "jest.config.js",
        "next.config.js",
        "postcss.config.js",
        "tailwind.config.js",
        "ntrip-proxy.js"
      ],
      "rules": {
        "@typescript-eslint/no-require-imports": "off"
      }
    },
    {
      "files": [
        "tests/**/*.mts",
        "tests/**/*.cts"
      ],
      "parserOptions": {
        "project": [
          "./tsconfig.lint-owned.json"
        ]
      }
    },
    {
      "files": [
        "next-env.d.ts"
      ],
      "rules": {
        "@typescript-eslint/triple-slash-reference": [
          "error",
          {
            "path": "always",
            "types": "prefer-import",
            "lib": "always"
          }
        ]
      }
    }
  ]
}
